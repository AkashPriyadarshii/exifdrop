<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher: Material3, DayNight, no ActionBar. Tokens live in Compose (ui/theme/Theme.kt).
         White bg only in light mode; values-night overrides the flash. -->
    <style name="Theme.ExifDrop" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/exifdrop_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Full-screen cover during the strip. Translucent so a share-sheet pick shows a clean
         solid cover (the paper bg is drawn as content on top) with no white splash; the
         status-bar icons are flipped for the light paper. -->
    <style name="Theme.ExifDrop.Trampoline" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@color/exifdrop_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>