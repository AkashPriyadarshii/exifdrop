<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher: Material3, DayNight, no ActionBar. Tokens live in Compose (ui/theme/Theme.kt).
         White bg only in light mode; values-night overrides the flash. -->
    <style name="Theme.ExifDrop" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/exifdrop_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Covers the whole screen during the strip before the destination chooser.
         Translucent: the window manager can never place a translucent activity into a
         freeform/floating window, so picking ExifDrop always lands as a true full-screen
         cover, never a resizable bubble (the original working config). The opaque paper
         cover is drawn as CONTENT on top, so the user sees a solid full-screen screen,
         not a transparent flash. -->
    <style name="Theme.ExifDrop.Trampoline" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@color/exifdrop_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>