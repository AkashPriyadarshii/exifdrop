<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher: Material3, DayNight, no ActionBar. Tokens live in Compose (ui/theme/Theme.kt).
         White bg only in light mode; values-night overrides the flash. -->
    <style name="Theme.ExifDrop" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/exifdrop_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Fully transparent, no window frame, no visible UI. The activity inflates nothing. -->
    <style name="Theme.ExifDrop.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>